# =============================================================================
# i3wm CONFIGURATION FILE
# =============================================================================

# --- Core Settings ---
set $mod Mod4
floating_modifier $mod
tiling_drag modifier titlebar
font pango:JetBrains Mono 10
default_border pixel 3
default_floating_border pixel 3

gaps inner 10

# --- Custom Color Palette ---
set $bg-dark    #1e1416
set $bg-light   #362225
set $text-std   #eedec8
set $accent     #e03e3e
set $gold       #ecc857
set $urgent     #d02a3a

# --- Window Borders & Decorations ---
#                       border          background      text            indicator       child_border
client.focused          $accent         $accent         $bg-dark        $gold           $accent
client.focused_inactive $bg-light        $bg-light       $text-std       $bg-dark        $bg-light
client.unfocused        $bg-dark        $bg-dark        $text-std       $bg-dark        $bg-dark
client.urgent           $urgent         $urgent         $text-std       $urgent         $urgent

# =============================================================================
# WORKSPACE DEFINITIONS
# =============================================================================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# =============================================================================
# KEYBINDINGS
# =============================================================================

# --- Session Management ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu.sh
bindsym $mod+Tab exec --no-startup-id rofi -show window


# --- Application Launchers ---
bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+f exec firefox
bindsym $mod+Shift+d exec firefox --new-window https://discord.com

# --- Window Focus Control ---
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# --- Window Movement ---
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Layout Control ---
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# --- Clipboard History (clipmenu) ---
bindsym $mod+c exec --no-startup-id CM_LAUNCHER=rofi clipmenu


# --- Screenshots (maim) ---
bindsym Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh full
bindsym $mod+Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh select
bindsym $mod+Shift+Print exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

# --- Hardware Media Controls ---
# Audio Controls
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && dunstify -h int:value:$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '[0-9]+(?=%)' | head -n 1) --stack-tag=volume -i audio-volume-high "Volume"
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && dunstify -h int:value:$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '[0-9]+(?=%)' | head -n 1) --stack-tag=volume -i audio-volume-low "Volume"
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && dunstify --stack-tag=volume -i audio-volume-muted "Mute Status Changed"
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && dunstify --stack-tag=microphone -i microphone-sensitivity-muted "Microphone Mute Status Changed"

# Brightness Controls
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5% && dunstify -h int:value:$(brightnessctl i | grep -Po '[0-9]+(?=%)' | head -n 1) --stack-tag=brightness -i display "Brightness"
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%- && dunstify -h int:value:$(brightnessctl i | grep -Po '[0-9]+(?=%)' | head -n 1) --stack-tag=brightness -i display "Brightness"

# =============================================================================
# WINDOW RULES
# =============================================================================

assign [title=".*Discord.*"] $ws3
for_window [title=".*Discord.*"] fullscreen enable

# =============================================================================
# MODES
# =============================================================================

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

