# =============================================================================
# AUTOSTART APPLICATIONS (DAEMONS & UTILITIES)
# =============================================================================

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet
exec --no-startup-id feh --bg-scale ~/Pictures/Wallpapers/Hsin.png
exec --no-startup-id picom -b
exec --no-startup-id dunst &
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
exec --no-startup-id clipmenud
exec_always --no-startup-id autotiling
exec --no-startup-id ~/.config/i3/scripts/sys_alerts.sh

# Open Dunst Notification Center Log
bindsym $mod+Shift+n exec --no-startup-id ~/.config/i3/scripts/noti_center.sh
