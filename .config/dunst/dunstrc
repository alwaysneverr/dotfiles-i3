# =============================================================================
# DUNST NOTIFICATION CONFIGURATION
# =============================================================================

[global]
    # --- Layout & Geometry ---
    monitor = 0
    follow = mouse
    width = 300
    height = 200
    origin = top-right
    offset = 10x40
    scale = 0
    notification_limit = 0

    # --- Visual Aesthetics ---
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 10
    text_icon_padding = 0
    
    # Matching your 'default_border pixel 1' rules
    frame_width = 1
    frame_color = "#362225"        # $bg-light
    separator_color = "#362225"    # $bg-light
    
    sort = yes

    # --- Typography & Text ---
    font = JetBrains Mono 9        # Matching your installed font family
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # --- Icons ---
    enable_graphic_drivers = true
    icon_position = left
    min_icon_size = 0
    max_icon_size = 32
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

    # --- System Integration ---
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab
    always_run_script = true
    title = dunst
    class = dunst
    corner_radius = 0
    cursor_type = left_ptr

[experimental]
    per_monitor_dpi = false

# =============================================================================
# THEME STYLING & URGENCY PROFILES
# =============================================================================

[urgency_low]
    background = "#1e1416"         # $bg-dark
    foreground = "#eedec8"         # $text-std
    timeout = 4
    # Optional: override frame color for low urgency
    # frame_color = "#362225"

[urgency_normal]
    background = "#362225"         # $bg-light
    foreground = "#eedec8"         # $text-std
    timeout = 10
    # Uses your primary accent line as the border frame
    frame_color = "#e03e3e"         # $accent 

[urgency_critical]
    background = "#1e1416"         # $bg-dark
    foreground = "#d02a3a"         # $urgent (Red Text)
    frame_color = "#ecc857"        # $gold (Gold Alert Frame)
    timeout = 0
